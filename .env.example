# Non-secret local configuration placeholders.
NEXT_PUBLIC_APP_NAME=AI Website Factory

# Server-only persistence. Leave blank for credential-free unit tests.
DATABASE_URL=postgresql://factory_user:replace-me@db.example.supabase.co:5432/postgres
# Optional future Supabase service-role integration; never expose to browser code.
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Server-only generated-project root. Tests must inject a temporary root.
GENERATED_PROJECTS_ROOT=D:\Visual Studio Code\save

# Server-only production AI provider. OPENAI_MODEL must be the provider-supported identifier.
OPENAI_API_KEY=
OPENAI_MODEL=GPT-5.6 Luna
OPENAI_REQUEST_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=1
OPENAI_MAX_CONCURRENT_REQUESTS=2
ALLOW_REAL_AI_SMOKE=false
