# Non-secret local configuration placeholders.
NEXT_PUBLIC_APP_NAME=AI Website Factory
ALLOW_GENERATED_RUNTIME_SMOKE=false
ALLOW_PLAYWRIGHT_SMOKE=false

# Server-only persistence. Leave blank for credential-free unit tests.
DATABASE_URL=postgresql://factory_user:replace-me@db.example.supabase.co:5432/postgres
# Optional future Supabase service-role integration; never expose to browser code.
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Server-only generated-project root. Tests must inject a temporary root.
GENERATED_PROJECTS_ROOT=D:\Visual Studio Code\save

# Server-only production AI provider. OPENAI_MODEL must be the provider-supported identifier.
OPENAI_API_KEY=
OPENAI_MODEL=GPT-5.6 Luna
OPENAI_REQUEST_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=1
OPENAI_MAX_CONCURRENT_REQUESTS=2
ALLOW_REAL_AI_SMOKE=false
ALLOW_REAL_FACTORY_E2E=false

# Optional server-only read-only Context7 integration. Disabled by default.
CONTEXT7_ENABLED=false
CONTEXT7_REQUEST_TIMEOUT_MS=8000
CONTEXT7_MAX_RETRIES=1
CONTEXT7_MAX_CONCURRENT_REQUESTS=2
CONTEXT7_CACHE_TTL_SECONDS=900
ALLOW_REAL_CONTEXT7_SMOKE=false

# Optional server-only read-only shadcn Registry integration. Disabled by default.
SHADCN_REGISTRY_ENABLED=false
SHADCN_REGISTRY_REQUEST_TIMEOUT_MS=8000
SHADCN_REGISTRY_MAX_RETRIES=1
SHADCN_REGISTRY_MAX_CONCURRENT_REQUESTS=2
SHADCN_REGISTRY_CACHE_TTL_SECONDS=900
ALLOW_REAL_SHADCN_SMOKE=false
ALLOW_GENERATED_RUNTIME_SMOKE=false
CODEBASE_MEMORY_ENABLED=false
CODEBASE_MEMORY_REQUEST_TIMEOUT_MS=10000
CODEBASE_MEMORY_MAX_CONCURRENT_REQUESTS=2
CODEBASE_MEMORY_CACHE_TTL_SECONDS=300
CODEBASE_MEMORY_MAX_RESULTS=30
CODEBASE_MEMORY_MAX_SOURCE_BYTES=20000
# Server-only validated executable path; leave unset unless real integration is explicitly enabled.
# CODEBASE_MEMORY_EXECUTABLE=
