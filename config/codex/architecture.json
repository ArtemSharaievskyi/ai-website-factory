{
  "version": 1,
  "sourceRoots": ["src"],
  "rules": [
    {
      "id": "UI_CANNOT_IMPORT_PERSISTENCE",
      "sourcePrefixes": ["src/app/"],
      "forbiddenTargetPrefixes": ["src/persistence/"],
      "message": "UI/app code must use an application service boundary instead of persistence directly."
    },
    {
      "id": "UI_CANNOT_IMPORT_OPENAI",
      "sourcePrefixes": ["src/app/"],
      "forbiddenTargetPrefixes": ["src/integrations/openai/"],
      "message": "UI/app code must not call the OpenAI integration directly."
    },
    {
      "id": "DOMAIN_CANNOT_IMPORT_WORKBENCH",
      "sourcePrefixes": ["src/domain/"],
      "forbiddenTargetPrefixes": ["src/runtime/workbench/", "src/app/"],
      "message": "Domain code must not depend on Workbench or UI routes."
    },
    {
      "id": "DOMAIN_CANNOT_IMPORT_PROVIDER",
      "sourcePrefixes": ["src/domain/"],
      "forbiddenTargetPrefixes": ["src/integrations/openai/", "src/integrations/"],
      "message": "Domain code must depend on contracts, not provider implementations."
    },
    {
      "id": "BRIEF_V3_CORE_CANNOT_IMPORT_RUNTIME",
      "sourcePrefixes": ["src/domain/requirements/v3/"],
      "forbiddenTargetPrefixes": ["src/integrations/", "src/runtime/", "src/persistence/", "src/app/"],
      "message": "Brief Revision V3 core must remain independent of provider, runtime, persistence, and UI implementations."
    },
    {
      "id": "BRIEF_V3_PROVIDER_CANNOT_IMPORT_AUTHORITY_MUTATION",
      "sourcePrefixes": ["src/integrations/openai-v3/mapper.ts", "src/integrations/openai-v3/prompt.ts", "src/integrations/openai-v3/provider.ts"],
      "forbiddenTargetPrefixes": ["src/domain/requirements/v3/reducer.ts", "src/domain/requirements/v3/history.ts", "src/domain/requirements/v3/migrate-v1.ts", "src/domain/requirements/v3/migrate-v2.ts", "src/domain/requirements/v3/legacy.ts", "src/persistence/", "src/runtime/workbench/", "src/app/"],
      "message": "The V3 provider boundary may map public semantic contracts but cannot own reducer, history, legacy, persistence, or workflow mutation authority."
    },
    {
      "id": "OPENAI_CANNOT_IMPORT_WORKBENCH",
      "sourcePrefixes": ["src/integrations/openai/"],
      "forbiddenTargetPrefixes": ["src/runtime/workbench/", "src/app/"],
      "message": "OpenAI integration code must not depend on Workbench UI or routes."
    },
    {
      "id": "PRODUCTION_BRIEF_MUTATION_CANNOT_IMPORT_V2_MUTATION",
      "sourcePrefixes": ["src/app/", "src/agents/lead/", "src/runtime/brief-revision-v3/", "src/runtime/trial-entry/", "src/runtime/workbench/"],
      "forbiddenTargetPrefixes": ["src/domain/requirements/revision.ts", "src/runtime/brief-revision-v3/v2-tripwire.ts"],
      "message": "Production Brief mutation areas may use only the V3 transaction authority; legacy V2 mutation modules are forbidden."
    },
    {
      "id": "PERSISTENCE_CANNOT_IMPORT_UI",
      "sourcePrefixes": ["src/persistence/"],
      "forbiddenTargetPrefixes": ["src/app/"],
      "message": "Persistence is server authority and must not depend on browser/client UI."
    },
    {
      "id": "OPENAI_CLIENT_BOUNDARY",
      "sourcePrefixes": ["src/"],
      "excludedSourcePrefixes": ["src/integrations/openai/"],
      "forbiddenModuleSpecifiers": ["openai"],
      "message": "Only the approved OpenAI integration boundary may import the provider client."
    }
  ]
}
