{
  "version": 1,
  "defaultCheckIds": ["typecheck", "lint"],
  "rules": [
    {
      "id": "openai-integration",
      "area": "OpenAI integration",
      "pathPrefixes": ["src/integrations/openai/", "src/agents/lead/ports.ts", "src/agents/lead/contracts.ts", "src/agents/planner/contracts.ts", "src/agents/design/contracts.ts", "src/agents/implementation/contracts.ts", "src/orchestration/orchestrator/contracts.ts", "src/domain/review/schema.ts"],
      "checkIds": ["provider-contracts", "openai-tests", "lead-provider-tests", "architecture", "typecheck", "lint"],
      "productionPathIds": ["BRIEF_V3_MUTATION_PATH"]
    },
    {
      "id": "brief-requirements",
      "area": "Brief requirements",
      "pathPrefixes": ["src/domain/requirements/", "src/agents/lead/", "src/runtime/trial-entry/", "src/runtime/workbench/brief-"],
      "checkIds": ["brief-tests", "brief-revision-certification", "brief-revision-tests", "lead-tests", "trial-entry-production-tests", "architecture", "typecheck", "lint"],
      "productionPathIds": ["TRIAL_ENTRY_CONTINUATION", "BRIEF_V3_MUTATION_PATH"]
    },
    {
      "id": "workbench",
      "area": "Workbench",
      "pathPrefixes": ["src/runtime/workbench/", "src/app/api/workbench/"],
      "checkIds": ["workbench-tests", "route-tests", "architecture", "typecheck", "lint"],
      "productionPathIds": ["WORKBENCH_MUTATION"]
    },
    {
      "id": "persistence",
      "area": "Persistence",
      "pathPrefixes": ["src/persistence/", "supabase/migrations/"],
      "checkIds": ["persistence-tests", "db-validation", "db-integrity", "db-verify", "architecture", "typecheck", "lint"]
    },
    {
      "id": "assets",
      "area": "Asset intake",
      "pathPrefixes": ["src/runtime/assets/", "src/domain/assets/", "src/app/api/workbench/assets/"],
      "checkIds": ["asset-tests", "architecture", "typecheck", "lint"],
      "productionPathIds": ["ASSET_INTAKE"]
    },
    {
      "id": "context",
      "area": "Context assembly",
      "pathPrefixes": ["src/runtime/context/"],
      "checkIds": ["context-lossless", "architecture", "typecheck", "lint"]
    },
    {
      "id": "architecture-boundaries",
      "area": "Architecture boundaries",
      "pathPrefixes": ["src/"],
      "checkIds": ["architecture"]
    },
    {
      "id": "codex-tooling",
      "area": "Codex verification tooling",
      "pathPrefixes": ["scripts/codex/", "config/codex/", "src/runtime/codex/"],
      "checkIds": ["tooling-tests", "typecheck", "lint"]
    }
  ]
}
