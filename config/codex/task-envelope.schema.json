{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-website-factory.local/schema/codex-task-envelope.schema.json",
  "title": "Codex task envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "expectedHead",
    "operation",
    "providerBudget",
    "allowedSourceMutation",
    "allowedCanonicalMutation",
    "targetState",
    "stopAt",
    "agentPolicy"
  ],
  "properties": {
    "mode": { "enum": ["SOURCE_REPAIR", "REAL_LIFECYCLE", "READ_ONLY_AUDIT"] },
    "expectedHead": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "protectedProjectId": { "type": "string", "format": "uuid" },
    "operation": { "type": "string", "minLength": 1, "pattern": "^[A-Z][A-Z0-9_]*$" },
    "providerBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lead": { "type": "integer", "minimum": 0, "maximum": 100 },
        "planner": { "type": "integer", "minimum": 0, "maximum": 100 },
        "architectureReview": { "type": "integer", "minimum": 0, "maximum": 100 },
        "design": { "type": "integer", "minimum": 0, "maximum": 100 },
        "contractAudit": { "type": "integer", "minimum": 0, "maximum": 100 },
        "codeIntegrationReview": { "type": "integer", "minimum": 0, "maximum": 100 },
        "securityReview": { "type": "integer", "minimum": 0, "maximum": 100 },
        "testQualityReview": { "type": "integer", "minimum": 0, "maximum": 100 },
        "implementation": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "allowedSourceMutation": { "type": "boolean" },
    "allowedCanonicalMutation": { "type": "boolean" },
    "targetState": { "type": "string", "minLength": 1 },
    "stopAt": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "USER_APPROVAL",
          "SOURCE_DEFECT",
          "PROVIDER_FAILURE",
          "PROVIDER_SEMANTIC_FAILURE",
          "CURRENTNESS_FAILURE",
          "PROVIDER_BUDGET",
          "CONTRACT_UNREPRESENTABLE",
          "BLOCKED",
          "CHANGES_REQUIRED"
        ]
      }
    },
    "agentPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "maxSubagents", "parallelCanonicalWrites", "singleIntegrationAuthority"],
      "properties": {
        "mode": { "enum": ["SINGLE", "BOUNDED_PARALLEL", "READ_ONLY_SWARM"] },
        "maxSubagents": { "type": "integer", "minimum": 0, "maximum": 4 },
        "parallelCanonicalWrites": { "const": false },
        "singleIntegrationAuthority": { "const": true },
        "canonicalMutationAuthorities": { "type": "array", "minItems": 0, "maxItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 120 } }
      }
    }
  }
}
